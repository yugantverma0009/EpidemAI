CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development
PORT=8000
TINYFISH_API_KEY=
TINYFISH_SOURCE_URLS=https://www.who.int/news,https://www.mohfw.gov.in/
INGEST_API_KEY=
# Optional backend scheduler. 0 disables all automatic TinyFish runs.
TINYFISH_COLLECTION_INTERVAL_SECONDS=0
# Set to a persistent disk path on hosting platforms that support mounted disks.
TINYFISH_DB_PATH=
# Phase 2 assistant history is opt-in and separate from TinyFish storage.
# Use a persistent, access-restricted path on hosted deployments.
ASSISTANT_DB_PATH=
ASSISTANT_RETENTION_DAYS=30
# Government scheme catalogue synchronization (set a strong random key before use).
SCHEME_SYNC_DB_PATH=app/data/health_navigator/schemes.sqlite3
SCHEME_SYNC_INTERVAL_SECONDS=604800
SCHEME_SYNC_REQUEST_DELAY_SECONDS=3
SCHEME_SYNC_USER_AGENT=EpidemAI-SchemeSync/0.1 (contact: configure-a-project-contact)
SCHEME_SYNC_ADMIN_KEY=change-this-before-enabling-admin-sync
ANTHROPIC_API_KEY=
LLM_MODEL=
