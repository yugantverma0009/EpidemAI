CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development
PORT=8000
# Phase 2 assistant history is opt-in and stored locally.
# Use a persistent, access-restricted path on hosted deployments.
ASSISTANT_DB_PATH=
ASSISTANT_RETENTION_DAYS=30
# Government scheme catalogue synchronization (set a strong random key before use).
SCHEME_SYNC_DB_PATH=app/data/health_navigator/schemes.sqlite3
SCHEME_SYNC_INTERVAL_SECONDS=604800
SCHEME_SYNC_REQUEST_DELAY_SECONDS=3
SCHEME_SYNC_USER_AGENT=EpidemAI-SchemeSync/0.1 (contact: configure-a-project-contact)
SCHEME_SYNC_ADMIN_KEY=change-this-before-enabling-admin-sync
ANTHROPIC_API_KEY=
LLM_MODEL=
# Google Gemini API for Agentic AI Healthcare Orchestration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
